# Copy to .env for local development. NEVER commit real secrets to GitHub.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL connection string (Local Docker or Neon Free PostgreSQL)
# Example Neon URL: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/campushub?sslmode=require
DATABASE_URL=postgresql://campushub:campushub@localhost:5432/campushub

# Optional: set to True on first Render deploy to load synthetic demo data for all 9 roles
SEED_DEMO_DATA=True
TIME_ZONE=Asia/Dhaka
